{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "polyaudit catalog inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_version", "generated_at", "scan_root", "output_directory", "dry_run", "settings", "projects"],
  "properties": {
    "schema_version": {"const": 1},
    "tool_version": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "scan_root": {"type": "string"},
    "output_directory": {"type": "string"},
    "dry_run": {"type": "boolean"},
    "settings": {"$ref": "#/$defs/settings"},
    "projects": {"type": "array", "items": {"$ref": "#/$defs/project"}},
    "diagnostics": {"$ref": "#/$defs/diagnostics"}
  },
  "$defs": {
    "settings": {
      "type": "object", "additionalProperties": false,
      "required": ["workers", "clean", "gzip", "max_file_bytes", "max_bundle_bytes"],
      "properties": {
        "workers": {"type": "integer", "minimum": 1, "maximum": 256},
        "clean": {"type": "boolean"},
        "gzip": {"type": "boolean"},
        "max_file_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "max_bundle_bytes": {"type": "integer", "minimum": 1024, "maximum": 1099511627776},
        "excludes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["severity", "path", "message"],
      "properties": {
        "severity": {"enum": ["error", "warning"]},
        "path": {"type": "string"},
        "message": {"type": "string"}
      }
    },
    "dependency": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "kind": {"enum": ["runtime", "development", "peer", "optional", "indirect", "role", "collection", "playbook"]},
        "source": {"type": "string"}
      }
    },
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "ecosystem", "language", "dependencies"],
      "properties": {
        "file": {"enum": ["package.json", "mix.exs", "go.mod", "site.yml"]},
        "ecosystem": {"enum": ["node", "elixir", "go", "ansible"]},
        "language": {"type": "string"},
        "name": {"type": "string"},
        "language_version": {"type": "string"},
        "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
        "attributes": {"type": "object", "additionalProperties": {"type": "string"}},
        "diagnostics": {"$ref": "#/$defs/diagnostics"}
      }
    },
    "bundle": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "compression", "files", "source_bytes", "bytes", "sha256", "omitted"],
      "properties": {
        "path": {"type": "string", "pattern": "^repo_packs/[a-f0-9]{32}/p-[a-f0-9]{64}\\.txt(\\.gz)?$"},
        "compression": {"enum": ["none", "gzip"]},
        "files": {"type": "integer", "minimum": 0},
        "source_bytes": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "omitted": {"type": "integer", "minimum": 0},
        "omissions": {
          "type": "array", "maxItems": 1000,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["path", "reason"],
            "properties": {"path": {"type": "string"}, "reason": {"type": "string"}}
          }
        }
      }
    },
    "cleanup": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "status"],
      "properties": {
        "path": {"type": "string"},
        "status": {"enum": ["planned", "deleted", "skipped", "failed"]},
        "message": {"type": "string"}
      }
    },
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "path", "primary_language", "languages", "manifests"],
      "properties": {
        "id": {"type": "string", "pattern": "^p-[a-f0-9]{64}$"},
        "name": {"type": "string"},
        "path": {"type": "string"},
        "parent_id": {"type": "string", "pattern": "^p-[a-f0-9]{64}$"},
        "primary_language": {"type": "string"},
        "languages": {"type": "array", "items": {"type": "string"}},
        "manifests": {"type": "array", "items": {"$ref": "#/$defs/manifest"}},
        "bundle": {"$ref": "#/$defs/bundle"},
        "cleanup": {"type": "array", "items": {"$ref": "#/$defs/cleanup"}},
        "diagnostics": {"$ref": "#/$defs/diagnostics"}
      }
    }
  }
}
